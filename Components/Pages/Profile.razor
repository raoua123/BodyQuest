@page "/profile"
@inherits LocalizedComponentBase
@inject ProfileService Profiles
@inject PlayerSession Session
@inject NavigationManager Navigation

<PageTitle>@L["p.title"]</PageTitle>

<div class="gd-page">
    <header class="gd-header">
        <a href="/" class="gd-logo"><span class="gd-logo-mark">B!</span><span>body<span>quest</span></span></a>
        <nav class="gd-nav">
            <a href="/"><svg class="bq-i"><use href="#i-map" /></svg> @L["nav.map"]</a>
            <a class="gd-nav-active" href="/profile"><svg class="bq-i"><use href="#i-user" /></svg> @L["nav.profile"]</a>
        </nav>
        <div class="gd-tools"><PlayerChip /><LangSwitcher /></div>
    </header>

    <main class="gd-main pf-main">
    @if (_p is null)
    {
        <div class="pf-loading"><img src="/images/body-explorer.png" alt="" /></div>
    }
    else
    {
        var next = _p.CurrentWorld;
        <section class="pf-hero">
            <div class="pf-card pf-id">
                <div class="pf-avatar-wrap">
                    <div class="pf-avatar"><img src="@AvatarPath" alt="" /></div>
                    <span class="pf-level">@L.F("p.level", _p.Level, _p.Stars)</span>
                </div>
                <div class="pf-id-text">
                    <h1>@DisplayName</h1>
                    <p class="pf-rank">@_p.Rank</p>
                    <div class="pf-xp">
                        <div class="gd-bar"><div class="gd-bar-fill" style="width:@(_p.LevelPercent)%"></div></div>
                        <small>@L.F("p.toNext", _p.LevelPercent)</small>
                    </div>
                </div>
            </div>

            <div class="pf-card pf-next">
                @if (next is not null)
                {
                    <div class="pf-next-body" style="--c:@next.Accent">
                        <img src="@next.Image" alt="" />
                        <div><strong>@WTitle(next)</strong><small>@next.LessonsDone / @next.LessonsTotal @L["home.lessons"]</small></div>
                    </div>
                    <button type="button" class="gd-cta" @onclick="() => Open(next.Slug)">
                        @L["home.continue"] <svg class="bq-i"><use href="#i-arrow" /></svg>
                    </button>
                }
                else
                {
                    <div class="pf-next-body pf-next-done"><img src="/images/body-explorer.png" alt="" /><div><strong>@L["home.allDone"]</strong></div></div>
                }
            </div>
        </section>

        <section class="pf-stats">
            <div class="pf-stat pf-stat-gold"><span><svg class="bq-i"><use href="#i-star" /></svg></span><div><strong>@_p.Stars</strong><small>@L["tip.stars"]</small></div></div>
            <div class="pf-stat pf-stat-green"><span><svg class="bq-i"><use href="#i-check" /></svg></span><div><strong>@_p.LessonsDone<em> / @_p.LessonsTotal</em></strong><small>@L["home.lessons"]</small></div></div>
            <div class="pf-stat pf-stat-purple"><span><svg class="bq-i"><use href="#i-map" /></svg></span><div><strong>@_p.WorldsDone<em> / @_p.Worlds.Count</em></strong><small>@L["home.worlds"]</small></div></div>
            <div class="pf-stat pf-stat-pink"><span><svg class="bq-i"><use href="#i-flag" /></svg></span><div><strong>@_p.BadgesEarned<em> / @_p.Badges.Count</em></strong><small>@L["p.badges"]</small></div></div>
        </section>

        <section class="pf-section">
            <div class="pf-heading"><h2>@L["home.garden"]</h2></div>
            <div class="pf-worlds">
                @foreach (var w in _p.Worlds)
                {
                    var world = w;
                    <button type="button" class="pf-world @(world.Unlocked ? "" : "is-locked")" disabled="@(!world.Unlocked)"
                            @onclick="() => Open(world.Slug)">
                        <span class="pf-ring" style="--c:@world.Accent;--p:@world.Percent">
                            <img src="@world.Image" alt="" />
                            @if (world.Completed) { <i class="pf-tick"><svg class="bq-i"><use href="#i-check" /></svg></i> }
                            else if (!world.Unlocked) { <i class="pf-lock"><svg class="bq-i"><use href="#i-lock" /></svg></i> }
                        </span>
                        <strong>@WTitle(world)</strong>
                        <small>@world.LessonsDone / @world.LessonsTotal</small>
                    </button>
                }
            </div>
        </section>

        <section class="pf-section pf-card">
            <div class="pf-badges-head">
                <div><span class="gd-eyebrow">@L["p.vict"]</span><h2>@L["p.badges"]</h2></div>
                <span class="pf-count">@_p.BadgesEarned / @_p.Badges.Count</span>
            </div>
            <div class="pf-badges">
                @foreach (var b in _p.Badges)
                {
                    <div class="pf-badge @(b.Earned ? "is-earned" : "is-locked")">
                        <span class="pf-badge-art"><img src="@b.Image" alt="" />@if (!b.Earned) { <i><svg class="bq-i"><use href="#i-lock" /></svg></i> }</span>
                        <strong>@b.Name</strong><small>@b.Hint</small>
                    </div>
                }
            </div>
        </section>
    }
    </main>
</div>

@code {
    private ProfileService.ExplorerProfile? _p;
    private PlayerInfo? _me;

    private string DisplayName => _me?.Name ?? _p!.Name;
    private string AvatarPath => _me?.AvatarPath ?? _p!.Avatar.Path;

    private string WTitle(ProfileService.WorldSummary w) =>
        I18n.WorldTitle(new BodyModule { Slug = w.Slug, Title = w.Title }, L.Lang);

    private void Open(string slug) => Navigation.NavigateTo("/module/" + slug);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await L.InitAsync();
        _me = await Session.GetAsync();
        _p = await Profiles.LoadAsync();
        StateHasChanged();
    }
}