
@page "/profile"

<PageTitle>Mon explorateur — BodyQuest</PageTitle>

<div class="bq-profile">

    <header class="bp-header">
        <a href="/" class="bp-brand">
            <span class="bp-brand-icon">B!</span>
            <span>body<span>quest</span></span>
        </a>

        <a href="/" class="bp-back">← Retour à l'aventure</a>
    </header>

    <main class="bp-main">

        <section class="bp-welcome">
            <div class="bp-welcome-text">
                <span class="bp-eyebrow">MON ESPACE D'EXPLORATION</span>
                <h1>Salut, petit <span>scientifique !</span></h1>
                <p>Ton corps cache encore plein de mystères. Prêt à continuer ton exploration ?</p>

                <div class="bp-level-card">
                    <div class="bp-avatar">
                        <img src="/images/body-explorer.png" alt="Mon explorateur" />
                    </div>
                    <div class="bp-level-info">
                        <strong>Explorateur cellulaire</strong>
                        <span>Niveau @_level · @_stars étoiles</span>
                        <div class="bp-level-progress">
                            <div style="width: @_levelProgress%"></div>
                        </div>
                        <small>@_levelProgress% vers le niveau suivant</small>
                    </div>
                </div>
            </div>

            <div class="bp-welcome-art">
                <div class="bp-orbit bp-orbit-one"></div>
                <div class="bp-orbit bp-orbit-two"></div>
                <span class="bp-floating bp-float-one">✦</span>
                <span class="bp-floating bp-float-two">＋</span>
                <span class="bp-floating bp-float-three">●</span>
                <img src="/images/body-explorer.png" alt="" />
                <div class="bp-speech">Explorons le corps humain !</div>
            </div>
        </section>

        <section class="bp-stats">
            <div class="bp-stat bp-stat-pink">
                <span class="bp-stat-icon">♥</span>
                <div><strong>@_completed</strong><small>Zones découvertes</small></div>
            </div>
            <div class="bp-stat bp-stat-purple">
                <span class="bp-stat-icon">✦</span>
                <div><strong>@_stars</strong><small>Étoiles gagnées</small></div>
            </div>
            <div class="bp-stat bp-stat-mint">
                <span class="bp-stat-icon">✎</span>
                <div><strong>12</strong><small>Quiz terminés</small></div>
            </div>
            <div class="bp-stat bp-stat-yellow">
                <span class="bp-stat-icon">♧</span>
                <div><strong>4</strong><small>Badges obtenus</small></div>
            </div>
        </section>

        <section class="bp-journey">
            <div class="bp-section-heading">
                <div>
                    <span class="bp-eyebrow">TON VOYAGE À L'INTÉRIEUR DE TOI</span>
                    <h2>La carte du <span>corps humain</span></h2>
                    <p>Explore chaque système pour découvrir ses secrets !</p>
                </div>
                <div class="bp-map-key">
                    <span><i class="key-done"></i> Découvert</span>
                    <span><i class="key-current"></i> En cours</span>
                    <span><i class="key-locked"></i> À découvrir</span>
                </div>
            </div>

            <div class="bp-map">
                <div class="bp-map-decoration bp-dna">〰</div>
                <div class="bp-map-decoration bp-cell">✧</div>
                <div class="bp-map-decoration bp-star">✦</div>
                <div class="bp-map-decoration bp-bubble">○</div>

                <svg class="bp-path" viewBox="0 0 1000 600" preserveAspectRatio="none">
                    <path d="M130 480 C210 440 220 350 330 350 S440 410 510 300 S650 180 730 230 S850 320 900 130"
                          fill="none" stroke="#d8c9f4" stroke-width="13"
                          stroke-linecap="round" stroke-dasharray="2 22"/>
                    <path d="M130 480 C210 440 220 350 330 350 S440 410 510 300 S650 180 730 230 S850 320 900 130"
                          fill="none" stroke="#ffffff" stroke-width="4"
                          stroke-linecap="round" stroke-dasharray="2 22"/>
                </svg>

                @foreach (var world in _worlds)
                {
                    <button class="bp-world @world.Status"
                            style="left:@(world.X)%; top:@(world.Y)%"
                            disabled="@(world.Status == "locked")"
                            @onclick="() => SelectWorld(world)">

                        <span class="bp-world-image">
                            <img src="@world.Image" alt="" />
                            @if (world.Status == "done")
                            {
                                <span class="bp-world-check">✓</span>
                            }
                            else if (world.Status == "locked")
                            {
                                <span class="bp-lock">🔒</span>
                            }
                        </span>
                        <span class="bp-world-label">@world.Name</span>
                        <span class="bp-world-sub">@world.Subtitle</span>
                    </button>
                }

                <div class="bp-map-caption">
                    <span>🧬</span>
                    <strong>Bienvenue dans ton corps !</strong>
                    <small>Un univers extraordinaire t'attend.</small>
                </div>
            </div>

            <div class="bp-selected-world">
                <div class="bp-selected-image">
                    <img src="@_selectedWorld.Image" alt="@_selectedWorld.Name" />
                </div>
                <div class="bp-selected-info">
                    <span class="bp-eyebrow">PROCHAINE ÉTAPE</span>
                    <h3>@_selectedWorld.Name</h3>
                    <p>@_selectedWorld.Description</p>
                    <span class="bp-world-reward">✦ Récompense : @_selectedWorld.Reward étoiles</span>
                </div>
                @if (_selectedWorld.Status != "locked")
                {
                    <button class="bp-continue" @onclick="ContinueAdventure">
                        @(_selectedWorld.Status == "done" ? "Revoir la zone" : "Continuer") <span>→</span>
                    </button>
                }
                else
                {
                    <span class="bp-coming-soon">Bientôt disponible 🔒</span>
                }
            </div>
        </section>

        <section class="bp-bottom">
            <div class="bp-achievements">
                <div class="bp-bottom-heading">
                    <div>
                        <span class="bp-eyebrow">TES PETITES VICTOIRES</span>
                        <h2>Ma collection de badges</h2>
                    </div>
                    <span class="bp-count">4 / 8</span>
                </div>

                <div class="bp-badges">
                    <div class="bp-badge-item">
                        <div class="bp-badge badge-brain"><img src="/images/brain.png" alt="" /></div>
                        <strong>Génie du cerveau</strong>
                        <small>Premier neurone découvert</small>
                    </div>
                    <div class="bp-badge-item">
                        <div class="bp-badge badge-heart"><img src="/images/heart.png" alt="" /></div>
                        <strong>Super cœur</strong>
                        <small>Maître des battements</small>
                    </div>
                    <div class="bp-badge-item">
                        <div class="bp-badge badge-lungs"><img src="/images/lungs.png" alt="" /></div>
                        <strong>Grand souffle</strong>
                        <small>Mission respiration réussie</small>
                    </div>
                    <div class="bp-badge-item">
                        <div class="bp-badge badge-cell"><img src="/images/blood-cell.png" alt="" /></div>
                        <strong>Mini biologiste</strong>
                        <small>Explorateur de cellules</small>
                    </div>
                </div>
            </div>

            <aside class="bp-fun-fact">
                <span class="bp-fact-icon">💡</span>
                <span class="bp-eyebrow">LE SAVIEZ-VOUS ?</span>
                <h3>Ton corps est incroyable !</h3>
                <p>Ton cœur bat environ 100 000 fois par jour. C'est comme une petite machine qui travaille sans jamais prendre de pause !</p>
                <span class="bp-fact-decoration">♥</span>
            </aside>
        </section>

        <footer class="bp-footer">
            <span>🧬 BodyQuest</span>
            <span>Chaque découverte te rapproche des secrets du corps humain.</span>
        </footer>

    </main>
</div>

@code {
    private int _level = 3;
    private int _stars = 125;
    private int _levelProgress = 68;
    private int _completed = 3;

    private List<BodyWorld> _worlds = new()
    {
        new BodyWorld
        {
            Name = "Le Royaume du cerveau",
            Subtitle = "Système nerveux",
            Image = "/images/brain.png",
            Description = "Découvre le centre de commande de ton corps : le cerveau, les neurones et leurs incroyables messages.",
            Reward = 30,
            Status = "done",
            X = 13,
            Y = 75
        },
        new BodyWorld
        {
            Name = "La Cité du cœur",
            Subtitle = "Circulation sanguine",
            Image = "/images/heart.png",
            Description = "Suis le voyage du sang et découvre comment ton cœur pompe la vie dans tout ton corps.",
            Reward = 25,
            Status = "done",
            X = 33,
            Y = 55
        },
        new BodyWorld
        {
            Name = "Les montagnes respiratoires",
            Subtitle = "Système respiratoire",
            Image = "/images/lungs.png",
            Description = "Entre dans tes poumons et découvre comment ton corps récupère l'oxygène dont il a besoin.",
            Reward = 25,
            Status = "current",
            X = 51,
            Y = 48
        },
        new BodyWorld
        {
            Name = "La vallée digestive",
            Subtitle = "Système digestif",
            Image = "/images/digestive.png",
            Description = "Suis le parcours des aliments et découvre comment ton corps transforme ce que tu manges en énergie.",
            Reward = 30,
            Status = "locked",
            X = 73,
            Y = 30
        },
        new BodyWorld
        {
            Name = "La forteresse des os",
            Subtitle = "Squelette et muscles",
            Image = "/images/skeleton.png",
            Description = "Explore les os et les muscles qui soutiennent ton corps et te permettent de bouger.",
            Reward = 30,
            Status = "locked",
            X = 89,
            Y = 49
        },
        new BodyWorld
        {
            Name = "L'univers des cellules",
            Subtitle = "Cellules et ADN",
            Image = "/images/blood-cell.png",
            Description = "Réduis-toi à une taille microscopique pour explorer les cellules, l'ADN et les composants du vivant.",
            Reward = 40,
            Status = "locked",
            X = 90,
            Y = 12
        }
    };

    private BodyWorld _selectedWorld = new()
    {
        Name = "Les montagnes respiratoires",
        Subtitle = "Système respiratoire",
        Image = "/images/lungs.png",
        Description = "Entre dans tes poumons et découvre comment ton corps récupère l'oxygène dont il a besoin.",
        Reward = 25,
        Status = "current"
    };

    private void SelectWorld(BodyWorld world)
    {
        _selectedWorld = world;
    }

    private void ContinueAdventure()
    {
        // Démonstration : cette action sera reliée à la page du module plus tard.
    }

    private class BodyWorld
    {
        public string Name { get; set; } = "";
        public string Subtitle { get; set; } = "";
        public string Image { get; set; } = "";
        public string Description { get; set; } = "";
        public int Reward { get; set; }
        public string Status { get; set; } = "locked";
        public double X { get; set; }
        public double Y { get; set; }
    }
}
