@page "/module/{Slug}"

@implements IAsyncDisposable
@inherits LocalizedComponentBase

@inject ModuleService Modules
@inject WorldProgressService Progress
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>BodyQuest - @(_module is null ? L["wd.title.default"] : MTitle)</PageTitle>

@{
    var art = WorldArt.For(_module?.Slug);
}

<div class="wd-page" style="--c:@(art.Accent);--soft:@(art.Soft);--sky1:@(art.SkyTop);--sky2:@(art.SkyBottom)">

    <div class="wd-sky" aria-hidden="true">
        <span class="wd-cloud wd-cloud-a"></span>
        <span class="wd-cloud wd-cloud-b"></span>
        <span class="wd-cloud wd-cloud-c"></span>
        <span class="wd-butterfly wd-bf-a" data-pop="1"></span>
        <span class="wd-butterfly wd-bf-b" data-pop="1"></span>
    </div>

    <header class="wd-header">
        <a href="/" class="wd-logo" data-snd="tap">
            <span class="wd-logo-mark">B!</span>
            <span>body<span>quest</span></span>
        </a>

        <div class="wd-tools">
            <span class="wd-chip-stars" title="@L["tip.stars"]">
                <svg class="bq-i"><use href="#i-star" /></svg> @_stars
            </span>
            <PlayerChip />
            <LangSwitcher />
            <button type="button" class="wd-tool @(_muted ? "is-off" : "")" title="@L["snd.title"]"
                    aria-label="@(_muted ? L["snd.on"] : L["snd.off"])" @onclick="ToggleSound">
                <svg class="bq-i"><use href="@(_muted ? "#i-speaker-off" : "#i-speaker")" /></svg>
            </button>
            <a href="/" class="wd-back" data-snd="tap">
                <svg class="bq-i"><use href="#i-back" /></svg> @L["nav.map"]
            </a>
        </div>
    </header>

    @if (_module is null)
    {
        <div class="wd-message">
            <img src="/images/portal.png" alt="" />
            <h2>@L["wd.notfound"]</h2>
            <p>@L["wd.notfound.p"]</p>
            <a href="/" class="wd-btn">@L["wd.backmap"]</a>
        </div>
    }
    else if (!_loaded)
    {
        <div class="wd-message">
            <img src="/images/body-explorer.png" alt="" class="wd-bob" />
            <h2>@L["wd.preparing"]</h2>
        </div>
    }
    else if (!_unlocked)
    {
        <div class="wd-message">
            <div class="wd-lock-art"><img src="@art.Image" alt="" /><span><svg class="bq-i"><use href="#i-lock" /></svg></span></div>
            <h2>@L["wd.locked"]</h2>
            <p>@L["wd.locked.p"]</p>
            <a href="/" class="wd-btn" data-snd="tap">@L["wd.backmap"]</a>
        </div>
    }
    else
    {
        <main class="wd-main">

            <section class="wd-intro">
                <div class="wd-intro-art">
                    <img src="@art.Image" alt="@MTitle" />
                    <span class="wd-spark wd-spark-a"></span>
                    <span class="wd-spark wd-spark-b"></span>
                </div>

                <div class="wd-intro-text">
                    <span class="wd-eyebrow">@L["home.world"] @(_worldNumber)</span>
                    <h1>@MTitle</h1>
                    <p class="wd-tagline">@I18n.Tagline(_module.Slug, L.Lang)</p>
                    <p>@I18n.WorldDesc(_module, L.Lang)</p>

                    <div class="wd-progress">
                        <div class="wd-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent">
                            <div class="wd-bar-fill" style="width:@(Percent)%"></div>
                        </div>
                        <span><strong>@CompletedCount</strong> / @_module.Lessons.Count @L["home.lessons"]</span>
                    </div>
                </div>
            </section>

            <section class="wd-stones" aria-label="@L["wd.lessonsAria"]">
                @for (var i = 0; i < _module.Lessons.Count; i++)
                {
                    var index = i;
                    var lesson = _module.Lessons[index];
                    var done = IsDone(lesson);
                    var open = CanOpen(index);

                    <div class="wd-stone-wrap">
                        @if (index > 0)
                        {
                            <span class="wd-stone-link @(IsDone(_module.Lessons[index - 1]) ? "is-done" : "")"></span>
                        }
                        <button type="button"
                                class="wd-stone @(done ? "is-done" : "") @(index == _active ? "is-active" : "") @(!open ? "is-locked" : "")"
                                data-snd="@(open ? "pop" : "locked")"
                                aria-label="@LTitle(lesson)" aria-current="@(index == _active ? "step" : null)"
                                @onclick="() => OpenLesson(index)">
                            @if (done)
                            {
                                <svg class="bq-i"><use href="#i-check" /></svg>
                            }
                            else if (!open)
                            {
                                <svg class="bq-i"><use href="#i-lock" /></svg>
                            }
                            else
                            {
                                <span>@(index + 1)</span>
                            }
                        </button>
                        <span class="wd-stone-label">@LTitle(lesson)</span>
                        @if (done)
                        {
                            <span class="wd-stone-stars">
                                @for (var s = 1; s <= 3; s++)
                                {
                                    <svg class="bq-i @(s <= StarsFor(lesson) ? "on" : "")"><use href="#i-star" /></svg>
                                }
                            </span>
                        }
                    </div>
                }
            </section>

            @if (_active >= 0 && _active < _module.Lessons.Count)
            {
                var lesson = _module.Lessons[_active];
                var extra = I18n.Extra(_module.Slug, lesson.SortOrder, L.Lang);
                var questions = QuizBank.ForLesson(_module.Slug, lesson.SortOrder, L.Lang);
                var done = IsDone(lesson);
                var image = extra?.Image ?? art.Mascot;

                <article class="wd-card" @key="lesson.Id">

                    <div class="wd-card-top">
                        <span class="wd-pill">@(L.F("wd.lessonOf", _active + 1, _module.Lessons.Count))</span>
                        @if (done)
                        {
                            <span class="wd-pill wd-pill-done"><svg class="bq-i"><use href="#i-check" /></svg> @L["wd.learned"]</span>
                        }
                    </div>

                    <div class="wd-card-body">
                        <div class="wd-art">
                            <img class="@(image.EndsWith(".webp") ? "is-round" : "")" src="@image" alt="" />
                            <span class="wd-spark wd-spark-a"></span>
                            <span class="wd-spark wd-spark-b"></span>
                        </div>

                        <div class="wd-text">
                            <h2>@LTitle(lesson)</h2>
                            <p class="wd-explain">@LText(lesson)</p>

                            <button type="button" class="wd-listen @(_speaking ? "is-on" : "")" data-snd="tap" @onclick="() => ToggleListen(lesson, extra)">
                                <svg class="bq-i"><use href="#i-speaker" /></svg>
                                @(_speaking ? L["wd.stop"] : L["wd.listen"])
                            </button>
                        </div>
                    </div>

                    @if (extra is not null)
                    {
                        <div class="wd-tiles">
                            <div class="wd-tile wd-tile-remember">
                                <small>@L["wd.remember"]</small>
                                <strong>@extra.Remember</strong>
                            </div>

                            <button type="button" class="wd-tile wd-tile-fact @(_factOpen ? "is-open" : "")"
                                    data-snd="@(_factOpen ? "close" : "open")" @onclick="ToggleFact" aria-expanded="@(_factOpen ? "true" : "false")">
                                <small>@L["wd.fun"]</small>
                                @if (_factOpen)
                                {
                                    <strong>@extra.FunFact</strong>
                                }
                                else
                                {
                                    <strong class="wd-tap">@L["wd.tap"]</strong>
                                }
                            </button>

                            <div class="wd-tile wd-tile-try">
                                <small>@L["wd.try"]</small>
                                <strong>@extra.TryIt</strong>
                            </div>
                        </div>
                    }

                    @if (done)
                    {
                        <div class="wd-success">
                            <img src="/images/body-explorer.png" alt="" />
                            <div>
                                <strong>@L["wd.great"]</strong>
                                <p>@L["wd.great.p"]</p>
                            </div>
                        </div>
                    }
                    else if (questions.Count > 0)
                    {
                        var qi = Math.Min(_qIndex, questions.Count - 1);
                        var q = questions[qi];
                        var order = OrderFor(lesson.Id, qi, q.Options.Length);

                        <div class="wd-quiz">
                            <div class="wd-quiz-head">
                                <span class="wd-pill wd-pill-quiz">
                                    @L["wd.quick"]
                                    <span class="wd-qcount">@(qi + 1) / @questions.Count</span>
                                </span>
                                <span class="wd-quiz-stars" aria-label="@(L.F("wd.starsAvail", PotentialStars))">
                                    @for (var s = 1; s <= 3; s++)
                                    {
                                        <svg class="bq-i @(s <= (_quizDone ? _earned : PotentialStars) ? "on" : "")"><use href="#i-star" /></svg>
                                    }
                                </span>
                            </div>

                            <div class="wd-qdots" aria-hidden="true">
                                @for (var d = 0; d < questions.Count; d++)
                                {
                                    <i class="@(d < qi || (d == qi && _qPassed) ? "is-done" : d == qi ? "is-now" : "")"></i>
                                }
                            </div>

                            <h3>@q.Text</h3>

                            <div class="wd-options">
                                @for (var o = 0; o < order.Length; o++)
                                {
                                    var shown = o;
                                    var original = order[shown];
                                    var isRight = original == q.CorrectIndex;
                                    var wrong = _wrong.Contains(shown);

                                    <button type="button"
                                            class="wd-option @(_qPassed && isRight ? "is-right" : "") @(wrong ? "is-wrong" : "")"
                                            disabled="@(_qPassed || wrong)"
                                            data-snd="tap"
                                            @onclick="() => PickAnswer(shown, order, q, questions.Count)">
                                        <i>@(L.Lang == "ar" ? "أبجد"[shown] : (char)('A' + shown))</i>
                                        <span>@q.Options[original]</span>
                                    </button>
                                }
                            </div>

                            @if (_qPassed)
                            {
                                <p class="wd-feedback is-good">@L["wd.correct"] @q.Why</p>
                            }
                            else if (_wrong.Count > 0)
                            {
                                <p class="wd-feedback is-try">@L["wd.notquite"]</p>
                            }

                            @if (_qPassed && !_quizDone)
                            {
                                <div class="wd-nextq">
                                    <button type="button" class="wd-btn" data-snd="pop" @onclick="NextQuestion">
                                        @L["wd.nextq"] <svg class="bq-i"><use href="#i-arrow" /></svg>
                                    </button>
                                </div>
                            }
                        </div>

                        <button type="button" class="wd-complete" disabled="@(!_quizDone || _saving)" data-snd="pop" @onclick="() => CompleteLesson(lesson, true)">
                            @(_saving ? L["wd.saving"] : L["wd.learnedBtn"])
                            <svg class="bq-i"><use href="#i-check" /></svg>
                        </button>
                        @if (!_quizDone)
                        {
                            <p class="wd-hint">@L["wd.hint"]</p>
                        }
                    }
                    else
                    {
                        <button type="button" class="wd-complete" disabled="@_saving" data-snd="pop" @onclick="() => CompleteLesson(lesson, false)">
                            @L["wd.learnedBtn"]
                            <svg class="bq-i"><use href="#i-check" /></svg>
                        </button>
                    }

                    @if (done)
                    {
                        <div class="wd-nav">
                            @if (_active > 0)
                            {
                                <button type="button" class="wd-btn wd-btn-ghost" data-snd="tap" @onclick="() => OpenLesson(_active - 1)">
                                    <svg class="bq-i"><use href="#i-back" /></svg> @L["wd.prev"]
                                </button>
                            }
                            @if (_active < _module.Lessons.Count - 1)
                            {
                                <button type="button" class="wd-btn" data-snd="pop" @onclick="() => OpenLesson(_active + 1)">
                                    @L["wd.next"] <svg class="bq-i"><use href="#i-arrow" /></svg>
                                </button>
                            }
                            else
                            {
                                <a href="/" class="wd-btn" data-snd="pop">
                                    @L["wd.toMap"] <svg class="bq-i"><use href="#i-arrow" /></svg>
                                </a>
                            }
                        </div>
                    }
                </article>
            }

            @if (_justFinished is not null)
            {
                <div class="wd-reward" role="status">
                    <svg class="bq-i"><use href="#i-star" /></svg>
                    <span>@_justFinished</span>
                </div>
            }
        </main>
    }

    @if (_celebrating && _module is not null)
    {
        <div class="wd-overlay" @onclick="CloseCelebration">
            <div class="wd-modal" @onclick:stopPropagation="true">
                <div class="wd-modal-art">
                    <img src="@art.Image" alt="" />
                    <span class="wd-spark wd-spark-a"></span>
                    <span class="wd-spark wd-spark-b"></span>
                </div>
                <span class="wd-eyebrow">@L["wd.completed"]</span>
                <h2>@(L.F("wd.mastered", MTitle))</h2>
                <div class="wd-modal-stars">
                    @for (var s = 1; s <= 3; s++)
                    {
                        <svg class="bq-i @(s <= WorldStars ? "on" : "")"><use href="#i-star" /></svg>
                    }
                </div>
                <p>
                    @if (_nextWorldTitle is not null)
                    {
                        <text>@L["wd.nextWaiting"] <strong>@_nextWorldTitle</strong></text>
                    }
                    else
                    {
                        <text>@L["wd.heroAll"]</text>
                    }
                </p>
                <div class="wd-modal-actions">
                    <button type="button" class="wd-btn wd-btn-ghost" @onclick="CloseCelebration">@L["wd.readAgain"]</button>
                    <a href="/" class="wd-btn" data-snd="pop">@L["wd.toMapBtn"] <svg class="bq-i"><use href="#i-arrow" /></svg></a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private BodyModule? _module;
    private List<BodyModule> _allModules = new();
    private HashSet<string> _completed = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> _starMap = new(StringComparer.OrdinalIgnoreCase);

    private bool _loaded, _unlocked, _saving, _muted, _speaking, _factOpen, _celebrating;
    private bool _qPassed, _quizDone;                  // current question answered / every question answered
    private int _active = -1, _worldNumber, _stars, _earned;
    private int _qIndex, _wrongTotal;                  // which question we are on, wrong answers in this lesson
    private readonly HashSet<int> _wrong = new();      // wrong answers on the current question
    private string? _nextWorldTitle, _justFinished;
    private int _speakToken;

    private string MTitle => _module is null ? "" : I18n.WorldTitle(_module, L.Lang);
    private string LTitle(Lesson l) => I18n.LessonTitle(_module!.Slug, l, L.Lang);
    private string LText(Lesson l) => I18n.LessonText(_module!.Slug, l, L.Lang);

    private int CompletedCount => _module?.Lessons.Count(IsDone) ?? 0;
    private int Percent => _module is null || _module.Lessons.Count == 0
        ? 0 : (int)Math.Round(CompletedCount * 100.0 / _module.Lessons.Count);
    // No mistake = 3 stars, one or two mistakes = 2 stars, more = 1 star.
    private int PotentialStars => _wrongTotal == 0 ? 3 : _wrongTotal <= 2 ? 2 : 1;
    private int WorldStars => _module is null || _module.Lessons.Count == 0 ? 0
        : Math.Clamp((int)Math.Round(_module.Lessons.Average(StarsFor)), 1, 3);

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _unlocked = false;
        _active = -1;
        _celebrating = false;
        _justFinished = null;
        _allModules = await Modules.GetAllAsync();
        _module = await Modules.GetBySlugAsync(Slug);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loaded || _module is null) return;

        await L.InitAsync();

        _completed = await Progress.GetCompletedAsync();
        _starMap = await Progress.GetStarsAsync();
        _stars = await Progress.GetTotalStarsAsync();
        _muted = await Progress.IsMutedAsync();

        var idx = _allModules.FindIndex(m => m.Slug == _module.Slug);
        _worldNumber = idx + 1;
        _unlocked = idx == 0 || (idx > 0 && AllDone(_allModules[idx - 1]));
        _loaded = true;

        if (_unlocked)
        {
            var first = _module.Lessons.FindIndex(l => !IsDone(l));
            StartLesson(first >= 0 ? first : 0);
        }

        StateHasChanged();
    }

    private bool AllDone(BodyModule m) =>
        m.Lessons.Count > 0 && m.Lessons.All(l => _completed.Contains(WorldProgressService.MakeKey(m.Slug, l.Id)));

    private bool IsDone(Lesson l) =>
        _module is not null && _completed.Contains(WorldProgressService.MakeKey(_module.Slug, l.Id));

    private int StarsFor(Lesson l) =>
        _module is not null && _starMap.TryGetValue(WorldProgressService.MakeKey(_module.Slug, l.Id), out var s) ? s : 1;

    private bool CanOpen(int index) =>
        _module is not null && index >= 0 && index < _module.Lessons.Count &&
        (index == 0 || IsDone(_module.Lessons[index - 1]));

    private void StartLesson(int index)
    {
        _active = index;
        _factOpen = false;
        _qIndex = 0;
        _qPassed = false;
        _quizDone = false;
        _earned = 0;
        _wrongTotal = 0;
        _wrong.Clear();
        _justFinished = null;
        StopSpeakingQuietly();
    }

    /// <summary>Shuffles the answers the same way every time for a given lesson and question.</summary>
    private static int[] OrderFor(int lessonId, int questionIndex, int count)
    {
        var order = Enumerable.Range(0, count).ToArray();
        var rng = new Random(lessonId * 31 + 7 + questionIndex * 101);
        for (var i = order.Length - 1; i > 0; i--)
        {
            var j = rng.Next(i + 1);
            (order[i], order[j]) = (order[j], order[i]);
        }
        return order;
    }

    private void OpenLesson(int index)
    {
        if (!CanOpen(index)) return;
        StartLesson(index);
    }

    private void ToggleFact() => _factOpen = !_factOpen;

    private async Task PickAnswer(int shown, int[] order, QuizBank.Question q, int total)
    {
        if (_qPassed) return;

        if (order[shown] == q.CorrectIndex)
        {
            _qPassed = true;
            if (_qIndex >= total - 1)
            {
                _quizDone = true;
                _earned = PotentialStars;
            }
            await Progress.PlayAsync("sparkle");
            await Progress.ConfettiAsync(false);
        }
        else
        {
            _wrong.Add(shown);
            _wrongTotal++;
            await Progress.PlayAsync("locked");
        }
    }

    private void NextQuestion()
    {
        _qIndex++;
        _qPassed = false;
        _wrong.Clear();
    }

    private async Task CompleteLesson(Lesson lesson, bool hasQuiz)
    {
        if (_saving || _module is null || !CanOpen(_active) || IsDone(lesson)) return;
        if (hasQuiz && !_quizDone) return;

        _saving = true;
        try
        {
            var stars = hasQuiz ? Math.Max(1, _earned) : 1;
            await Progress.MarkCompletedAsync(_module.Slug, lesson.Id, stars);
            _completed = await Progress.GetCompletedAsync();
            _starMap = await Progress.GetStarsAsync();
            _stars = await Progress.GetTotalStarsAsync();

            if (AllDone(_module))
            {
                var idx = _allModules.FindIndex(m => m.Slug == _module.Slug);
                _nextWorldTitle = idx >= 0 && idx < _allModules.Count - 1
                    ? I18n.WorldTitle(_allModules[idx + 1], L.Lang) : null;
                _celebrating = true;
                await Progress.PlayAsync("world");
                await Progress.ConfettiAsync(true);
            }
            else
            {
                _justFinished = stars == 1 ? L["wd.reward1"] : L.F("wd.rewardN", stars);
                await Progress.PlayCompletionSoundAsync();
                await Progress.ConfettiAsync(false);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CloseCelebration()
    {
        _celebrating = false;
        await Progress.PlayAsync("close");
    }

    private async Task ToggleSound() => _muted = await Progress.SetMutedAsync(!_muted);

    private async Task ToggleListen(Lesson lesson, LessonExtras.Extra? extra)
    {
        var token = ++_speakToken;
        if (_speaking)
        {
            _speaking = false;
            await SafeJs(() => JS.InvokeVoidAsync("bodyQuestWorlds.stopSpeaking").AsTask());
            return;
        }

        var text = $"{LTitle(lesson)}. {LText(lesson)} {extra?.Remember}";
        var ok = await JS.InvokeAsync<bool>("bodyQuestWorlds.speak", text, L.SpeechLang);
        if (!ok) return;

        _speaking = true;
        StateHasChanged();
        // Speech has no "finished" callback here, so the button resets after the estimated reading time.
        await Task.Delay(Math.Clamp(text.Length * 75, 2500, 30000));
        if (token == _speakToken)
        {
            _speaking = false;
            StateHasChanged();
        }
    }

    private void StopSpeakingQuietly()
    {
        _speaking = false;
        _speakToken++;
        _ = SafeJs(() => JS.InvokeVoidAsync("bodyQuestWorlds.stopSpeaking").AsTask());
    }

    private static async Task SafeJs(Func<Task> call)
    {
        try { await call(); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await SafeJs(() => JS.InvokeVoidAsync("bodyQuestWorlds.stopSpeaking").AsTask());
    }
}